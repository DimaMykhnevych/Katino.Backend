{
  "ConnectionStrings": {
    "Default": "set your connection string here",
    "AzureStorage": ""
  },
  "SecretKeyOptions": {
    "SecretKey": "set your bearer secret key here"
  },
  "EmailServiceOptions": {
    "EmailAddress": "Pass your company email address here",
    "Password": "Pass your company password here"
  },
  "EmailConfirmationEnabled": "true",
  "SwaggerOptions": {
    "JsonRoute": "swagger/{documentName}/swagger.json",
    "Description": "Katino.API",
    "UIEndpoint": "v1/swagger.json"
  },
  "AzureStorage": {
    "PhotoContainerName": "product-photos",
    "FinanceReportContainerName": "finance-reports"
  },
  "NovaPostOptions": {
    "BaseUrl": "https://api.novaposhta.ua/v2.0/json/",
    "ApiKey":  "Pass your API Key here",
    "InternetDocumentTimeoutSeconds": 30,
    "RequestTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "AuthPermitLimit": 5,
    "AuthWindowSeconds": 60,
    "AuthSegmentsPerWindow": 4
  }
}
